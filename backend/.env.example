# Hackathon Backend — local development configuration.
#
# Copy to `.env`: `cp .env.example .env`.
# Every value below is the built-in default, so an empty .env is valid.

# ---- app ----
APP_NAME=hackathon
APP_ENV=development
APP_AUTO_MIGRATE=true

# ---- http ----
HTTP_HOST=0.0.0.0
HTTP_PORT=20080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# ---- database ----
DATABASE_HOST=localhost
DATABASE_PORT=20543
DATABASE_USER=hackathon
DATABASE_PASSWORD=hackathon
DATABASE_NAME=hackathon
DATABASE_SSL_MODE=disable
DATABASE_TIMEZONE=UTC
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_LOG_LEVEL=warn
DATABASE_SLOW_QUERY_THRESHOLD=200ms

# ---- logging ----
LOG_LEVEL=info
LOG_FORMAT=console

# ---- cors ----
CORS_ALLOWED_ORIGINS=http://localhost:20000

# JWT Authentication
JWT_SECRET=hackathon-jwt-secret-key-change-in-prod
JWT_ACCESS_TOKEN_TTL=24h
JWT_REFRESH_TOKEN_TTL=168h
# ---- ai ----
# Both keys are OPTIONAL. An unset key disables that integration (the endpoint
# answers 503 with an explanation); it does not stop the API from booting.
#
# Gemini — check-in analysis, coach, emergency plans, education.
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-3.5-flash
# Deepgram — speech-to-text and text-to-speech.
AI_DEEPGRAM_API_KEY=
AI_DEEPGRAM_STT_MODEL=nova-2
AI_DEEPGRAM_TTS_MODEL=aura-asteria-en
# Upstream call timeout and the maximum accepted check-in recording size.
AI_REQUEST_TIMEOUT=60s
AI_MAX_AUDIO_BYTES=10485760

# Hackathon Project — docker compose configuration.
#
# Copy to `.env` at the repo root: `cp .env.example .env`. Compose reads it
# automatically. Every value has a default, so an empty file works.

# Image tag / version stamped into the API binary and reported by /healthz.
VERSION=dev

# development | production
APP_ENV=development

# ---- published host ports (range 20000 - 21000) ----
API_PORT=20080
WEB_PORT=20000
DATABASE_HOST_PORT=20543

# ---- database ----
DATABASE_USER=hackathon
DATABASE_PASSWORD=hackathon
DATABASE_NAME=hackathon
DATABASE_SSL_MODE=disable
DATABASE_PORT=5432

# ---- logging ----
LOG_LEVEL=info
LOG_FORMAT=console

# ---- web ----
NEXT_PUBLIC_API_URL=http://localhost:20080/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:20000

# ---- ai (both optional: an unset key disables that feature, it does not
#      stop the API from booting) ----
# Gemini — check-in analysis, coach, emergency plans, education.
#   https://aistudio.google.com/apikey
AI_GEMINI_API_KEY=
# Deepgram — speech-to-text and text-to-speech.
#   https://console.deepgram.com
AI_DEEPGRAM_API_KEY=
